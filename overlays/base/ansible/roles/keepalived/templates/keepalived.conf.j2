! Generated by Ansible - do not edit manually
vrrp_instance VI_{{ keepalived_vr_id }} {
    state {{ keepalived_state }}
    interface {{ keepalived_interface }}
    virtual_router_id {{ keepalived_vr_id }}
    priority {{ keepalived_priority }}
    advert_int {{ keepalived_advert_int }}

    authentication {
        auth_type {{ keepalived_auth_type | default('PASS') }}
{% if keepalived_auth_type == 'PASS' %}
        auth_pass {{ keepalived_auth_pass }}
{% endif %}
    }

{% if keepalived_track_scripts | length > 0 %}
    track_script {
{% for s in keepalived_track_scripts %}
        {{ s.name }} {
            script "{{ s.script_path | default('/usr/local/bin/' ~ s.name) }}"
            interval {{ s.interval | default(2) }}
            timeout {{ s.timeout | default(3) }}
        }
{% endfor %}
    }
{% endif %}

    virtual_ipaddress {
{% for vip in keepalived_vips %}
        {{ vip.address }}
{% endfor %}
    }

{% if keepalived_track_scripts | length > 0 %}
    track_interface {
{% for s in keepalived_track_scripts %}
        {{ s.track_interface | default(keepalived_interface) }}
{% endfor %}
    }
{% endif %}
}

{% if keepalived_check_haproxy | bool %}
vrrp_script chk_haproxy {
    script "systemctl is-active --quiet haproxy"
    interval 2
    weight -20
}
{% endif %}

