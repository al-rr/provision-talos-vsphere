# Oracle Linux Server 8
# Use text install
text

# repo --name="AppStream" --baseurl=file:///run/install/sources/mount-0000-cdrom/AppStream

### Accepts the End User License Agreement.
eula --agreed

# Use CDROM installation media
cdrom

# kexec-tools
# @^minimal-environment
%packages
@core
open-vm-tools
net-tools
perl
-iwl*firmware
-ftp
-net-snmp
-telnet
-telnet-server
-tftp
-tftp-server
-xinetd
-ypbind
-ypserv

%end

# Keyboard layouts
keyboard --xlayouts='us (intl)','br'

# System language
lang pt_BR.UTF-8 --addsupport=en_US.UTF-8

# Network information
# network --bootproto=dhcp --device=ens192 --onboot=on --activate 
network --hostname=teste.al.rr.leg.br --bootproto=dhcp --onboot=on --nameserver=192.168.0.139
# network --hostname=teste.al.rr.leg.br --bootproto=static --ip=192.168.0.15 --netmask=255.255.255.0 --gateway=192.168.0.2 --nameserver=192.168.0.139


# Run the Setup Agent on first boot
firstboot --enable

ignoredisk --only-use=sda
autopart
# Partition clearing information
clearpart --none --initlabel

# System timezone
timezone America/Boa_Vista --isUtc --nontp

# Credentials
### Lock the root account.
rootpw --lock
# Root password
rootpw --iscrypted $6$aPZ6iZnqiZxBmnQl$g6RnEqbdTwlvO3wd0PwJR/nDToWdLXelOcJTXoKDn1OVWJj7rrbIcqCLqdesFOOwdL4p7kcGzDaMiDQnn/ofK/
user --groups=wheel --name=ednil --password=$6$Qi81Sc2x5tTXoYuz$KAnGH5hz6sIA0dgGsmFga6XYeJRO5whYfYY4uIA9CvoOAIRN.C6ARlKeHVxdkunSRFhFRN0aYb3I/tHb6qa0w/ --iscrypted --gecos="Ednil Libanio da Costa Junior"

%addon com_redhat_kdump --enable --reserve-mb='auto'

%end

# %post
# dnf install -y sudo open-vm-tools
# %end

%anaconda
pwpolicy root --minlen=6 --minquality=1 --notstrict --nochanges --notempty
pwpolicy user --minlen=6 --minquality=1 --notstrict --nochanges --emptyok
pwpolicy luks --minlen=6 --minquality=1 --notstrict --nochanges --notempty
%end

reboot --eject