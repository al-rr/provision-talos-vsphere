#!/usr/bin/env bash
# Local-only overrides for packer/env.sh.
# Copy to packer/env.local.sh and adjust values.
# This file must never contain production credentials in git.

# Optional: choose default overlay when sourcing packer/env.sh
# export OVERLAY_ENV="lab"

# Optional: override vSphere credentials locally (takes precedence)
# export VSPHERE_ENDPOINT="192.168.0.233"
# export VSPHERE_USERNAME="root"
# export VSPHERE_PASSWORD="CHANGE_ME"
# export VSPHERE_INSECURE_CONNECTION="true"

# Optional: guest build account overrides for vsphere-iso
# export BUILD_USERNAME="vagrant"
# export BUILD_PASSWORD="vagrant"

# Optional: enable Packer logs
# export PACKER_ENABLE_LOG="true"
# export PACKER_LOG_PATH="/tmp/packer/packer.log"
